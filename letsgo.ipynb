    "    ax.set_xlabel('Age (Years)', fontsize=12)\n",
    "    ax.set_ylabel('Frequency (Count)', fontsize=12)\n",
    "    ax.set_xlim(age_limit) # Apply the consistent age limit\n",
    "\n",
    "# 6. Improve layout and display the single figure\n",
